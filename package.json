{
  "name": "volox",
  "version": "2.0.0",
  "description": "Volox - Volume, the way it should be.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "npx electron-builder",
    "build:mac": "npx electron-builder --mac",
    "build:win": "npx electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^40.1.0",
    "electron-builder": "^26.4.0"
  },
  "build": {
    "appId": "com.volox.app",
    "productName": "Volox",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      ".env"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "artifactName": "volox-${version}.${ext}"
    },
    "win": {
      "target": "nsis",
      "artifactName": "volox-setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "electron-store": "^11.0.2",
    "firebase": "^12.8.0",
    "loudness": "^0.4.2"
  },
  "optionalDependencies": {
    "koffi": "^2.15.1"
  }
}
